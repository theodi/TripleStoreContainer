PREFIX : <http://jena.apache.org/fuseki#>
PREFIX ja: <http://jena.hpl.hp.com/2005/11/Assembler#>
PREFIX text: <http://jena.apache.org/text#>
PREFIX tdb2: <http://jena.apache.org/2016/tdb#>

# Read the index configs too (resolved relative to this file)
<> ja:imports <text-indexing.ttl> .
<> ja:imports <spatial-indexing.ttl> .

[
    a :Service ;

    # The path prefix for this service
    # Empty string makes it the root
    :name "" ;

    :endpoint [
        # A SPARQL endpoint
        :operation :query ;

        # The path prefix for this endpoint
        :name "sparql" ;

        # Cancel queries running longer than 20 seconds (in milliseconds).
        # Fuseki applies this on an endpoint or the server, not on a service.
        ja:context [
            ja:cxtName "arq:queryTimeout" ;
            ja:cxtValue "20000"
        ]
    ] ;

    :endpoint [
        # A Graph Store Protocol endpoint
        :operation :gsp-r ;

        :name "graph"
    ] ;

    # The data exposed by this service
    :dataset [
        # Full-text search
        # See https://jena.apache.org/documentation/query/text-query.html
        a text:TextDataset ;

        # Text index (see text-indexing.ttl)
        text:index <urn:triple-store:text-index> ;

        # The underlying dataset, with GeoSPARQL and spatial search (see
        # spatial-indexing.ttl).
        # To turn spatial indexing off, remove the import of
        # spatial-indexing.ttl above and use the store directly:
        # text:dataset <urn:triple-store:store> ;
        text:dataset <urn:triple-store:spatial-dataset> ;
    ] ;
] .


# The store, with inferred triples already added at build time (see inference.ttl)
<urn:triple-store:store>
    a tdb2:DatasetTDB2 ;
    tdb2:location "./db" ;
.
